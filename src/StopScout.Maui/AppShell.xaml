<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="StopScout.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:StopScout.Maui.Views"
    Title="Stop Scout"
    FlyoutBehavior="Disabled">

    <TabBar>
        <Tab Title="Odjazdy">
            <ShellContent ContentTemplate="{DataTemplate views:DeparturesPage}" Route="departures" />
        </Tab>
        <Tab Title="Mapa">
            <ShellContent ContentTemplate="{DataTemplate views:MapPlaceholderPage}" Route="map" />
        </Tab>
        <Tab Title="Konto">
            <ShellContent ContentTemplate="{DataTemplate views:AccountPlaceholderPage}" Route="account" />
        </Tab>
    </TabBar>
</Shell>
