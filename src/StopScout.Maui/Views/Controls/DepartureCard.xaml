<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="StopScout.Maui.Views.Controls.DepartureCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:StopScout.Maui.Views.Controls"
    xmlns:models="clr-namespace:StopScout.Maui.Models"
    x:Name="Root">

    <Border
        Padding="12"
        Margin="0,0,0,10"
        BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
        Stroke="{AppThemeBinding Light={StaticResource CardStroke}, Dark={StaticResource CardStrokeDark}}"
        StrokeThickness="1"
        StrokeShape="RoundRectangle 12">
        <Grid ColumnDefinitions="56,*" ColumnSpacing="12">
            <Border
                Grid.Column="0"
                Padding="4"
                BackgroundColor="{AppThemeBinding Light={StaticResource LineBadge}, Dark={StaticResource LineBadgeDark}}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 8"
                VerticalOptions="Center"
                HeightRequest="48"
                WidthRequest="56">
                <Label
                    Text="{Binding Item.Line, Source={x:Reference Root}}"
                    FontFamily="OpenSansSemibold"
                    FontSize="18"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center"
                    TextColor="{AppThemeBinding Light={StaticResource LineBadgeText}, Dark={StaticResource LineBadgeTextDark}}" />
            </Border>

            <Grid
                Grid.Column="1"
                RowDefinitions="Auto,Auto"
                ColumnDefinitions="*,Auto"
                RowSpacing="4"
                ColumnSpacing="8">
                <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="{Binding Item.Headsign, Source={x:Reference Root}}"
                    FontFamily="OpenSansSemibold"
                    FontSize="16"
                    LineBreakMode="TailTruncation"
                    TextColor="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource White}}" />

                <Label
                    Grid.Row="0"
                    Grid.Column="1"
                    Text="{Binding Item.TimeText, Source={x:Reference Root}}"
                    FontFamily="OpenSansSemibold"
                    FontSize="16"
                    HorizontalTextAlignment="End"
                    TextColor="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource White}}" />

                <Label
                    Grid.Row="1"
                    Grid.Column="0"
                    Text="{Binding Item.RelativeText, Source={x:Reference Root}}"
                    FontSize="13"
                    TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />

                <controls:DelayHighlight
                    Grid.Row="1"
                    Grid.Column="1"
                    HorizontalOptions="End"
                    Status="{Binding Item.Status, Source={x:Reference Root}}" />
            </Grid>
        </Grid>
    </Border>
</ContentView>
