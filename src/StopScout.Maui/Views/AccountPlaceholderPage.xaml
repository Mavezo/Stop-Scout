<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StopScout.Maui.Views.AccountPlaceholderPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Konto"
    Padding="24">
    <VerticalStackLayout VerticalOptions="Center" Spacing="8">
        <Label
            Text="Konto"
            FontFamily="OpenSansSemibold"
            FontSize="22"
            HorizontalTextAlignment="Center"
            TextColor="{AppThemeBinding Light={StaticResource Gray950}, Dark={StaticResource White}}" />
        <Label
            Text="Rejestracja, logowanie i ulubione przystanki pojawią się tutaj."
            HorizontalTextAlignment="Center"
            TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
    </VerticalStackLayout>
</ContentPage>
